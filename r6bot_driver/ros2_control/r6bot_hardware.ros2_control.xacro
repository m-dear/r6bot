<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    r6bot_hardware_ros2_control macro
    ══════════════════════════════════
    Inserts the <ros2_control> block into the robot URDF.

    Parameters:
      name          — unique name for this hardware instance (e.g. "r6bot")
      robot_ip      — IP address of the robot or Python simulator
      robot_port    — port the robot listens on for commands   (default 30000)
      local_port    — port this PC binds to for state replies  (default 30001)

    Joint interfaces:
      command: position  (joint_trajectory_controller uses this)
      state:   position, velocity, effort
  -->
  <xacro:macro name="r6bot_hardware_ros2_control" params="
      name
      robot_ip
      robot_port:=30000
      local_port:=30001">

    <ros2_control name="${name}" type="system">

      <!-- ── Hardware plugin ────────────────────────────────────────────── -->
      <hardware>
        <plugin>r6bot_driver/R6botHardware</plugin>

        <!-- Connection parameters — edit robot_ip to match your robot -->
        <param name="robot_ip">${robot_ip}</param>
        <param name="robot_port">${robot_port}</param>
        <param name="local_port">${local_port}</param>
      </hardware>

      <!-- ── Joint 1 — shoulder pan (Z rotation) ──────────────────────── -->
      <joint name="joint_1">
        <command_interface name="position">
          <param name="min">${-pi}</param>
          <param name="max">${pi}</param>
        </command_interface>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- ── Joint 2 — shoulder lift ──────────────────────────────────── -->
      <joint name="joint_2">
        <command_interface name="position">
          <param name="min">${-pi}</param>
          <param name="max">${pi}</param>
        </command_interface>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- ── Joint 3 — elbow ──────────────────────────────────────────── -->
      <joint name="joint_3">
        <command_interface name="position">
          <param name="min">${-pi}</param>
          <param name="max">${pi}</param>
        </command_interface>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- ── Joint 4 — wrist 1 ────────────────────────────────────────── -->
      <joint name="joint_4">
        <command_interface name="position">
          <param name="min">${-pi}</param>
          <param name="max">${pi}</param>
        </command_interface>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- ── Joint 5 — wrist 2 ────────────────────────────────────────── -->
      <joint name="joint_5">
        <command_interface name="position">
          <param name="min">${-pi}</param>
          <param name="max">${pi}</param>
        </command_interface>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- ── Joint 6 — wrist 3 ────────────────────────────────────────── -->
      <joint name="joint_6">
        <command_interface name="position">
          <param name="min">${-pi}</param>
          <param name="max">${pi}</param>
        </command_interface>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

    </ros2_control>

  </xacro:macro>

</robot>
